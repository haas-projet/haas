{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "haas-projet/backend",
    "type": "project",
    "description": "API communautaire HAAS",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-pdo_pgsql": "*",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.3.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12.2",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6",
        "nikic/php-parser": "^5.9",
        "phpstan/phpstan": "^2.2.16",
        "phpunit/phpunit": "^12.5.12",
        "symfony/yaml": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "@php vendor/bin/pint --test",
        "format": "@php vendor/bin/pint",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=512M --no-progress",
        "test": "@php vendor/bin/phpunit --testsuite Unit,Feature,Architecture",
        "test:architecture": "@php vendor/bin/phpunit --testsuite Architecture",
        "test:integration": "@php vendor/bin/phpunit --testsuite Integration",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "platform": { "php": "8.4.0" },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
