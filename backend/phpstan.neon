includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: 8
    phpVersion: 80400
    configDirectories:
        - config
        - demo/config
    paths:
        - app
        - bootstrap/app.php
        - bootstrap/providers.php
        - config
        - database
        - routes
        - tests
        - demo/bootstrap
        - demo/config
        - demo/database
        - demo/routes
        - demo/public
        - demo/artisan
    tmpDir: .phpstan.cache
    reportUnmatchedIgnoredErrors: true
