# Exemple public, ne pas utiliser sans adapter et tester. Aucun secret inclus.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.haas.example.com
FRONTEND_URL=https://app.haas.example.com
SESSION_DRIVER=database
SESSION_COOKIE=haas_session
SESSION_DOMAIN=.haas.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=app.haas.example.com
CORS_ALLOWED_ORIGINS=https://app.haas.example.com
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=haas_app
DB_USERNAME=haas_app
QUEUE_CONNECTION=database
CACHE_STORE=database
LAB_MAX_RUNNING=1
LAB_RUNNER_SOCKET=/run/haas-lab/runner.sock
# APP_KEY, DB_PASSWORD, SMTP et sauvegarde à injecter hors dépôt.
# FRONTEND_URL, CORS_ALLOWED_ORIGINS et LAB_* sont des conventions HAAS à câbler.
